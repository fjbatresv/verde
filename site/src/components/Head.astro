---
import Default from '@astrojs/starlight/components/Head.astro';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

const SITE = 'https://verde.fjbatresv.com';
const route = Astro.locals.starlightRoute;
const lang = route.lang?.startsWith('en') ? 'en' : 'es';
const isHome = route.id === '' || route.id === 'en';
const is404 = route.id === '404';

// La 404 no se indexa ni apunta a una URL canónica que no existe.
if (is404) {
  route.head = route.head.filter((tag) => !(tag.tag === 'link' && tag.attrs?.rel === 'canonical'));
  route.head.push({ tag: 'meta', attrs: { name: 'robots', content: 'noindex, follow' }, content: undefined });
}

// Datos estructurados de las páginas internas; la portada trae los suyos (Landing.astro).
let jsonLd: object | null = null;
if (!isHome && !is404) {
  const url = new URL(Astro.url.pathname, SITE).href;
  const homeUrl = `${SITE}${lang === 'en' ? '/en/' : '/'}`;
  const sections: Record<string, { es: string; en: string }> = {
    ejemplo: { es: 'Ejemplo resuelto', en: 'Worked example' },
    changelog: { es: 'Changelog', en: 'Changelog' },
  };
  const [section, ...rest] = route.id.replace(/^en\//, '').split('/');
  const crumbs = [{ name: 'VERDE', item: homeUrl }];
  if (rest.length > 0 && sections[section]) {
    crumbs.push({ name: sections[section][lang], item: `${homeUrl}${section}/` });
  }
  crumbs.push({ name: route.entry.data.title, item: url });
  const author = { '@type': 'Person', '@id': 'https://fjbatresv.com/#person', name: 'Javier Batres', url: 'https://fjbatresv.com' };
  jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'TechArticle',
        '@id': `${url}#article`,
        headline: route.entry.data.title,
        description: route.entry.data.description,
        url,
        inLanguage: lang,
        image: `${SITE}/og.png`,
        isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'VERDE', url: `${SITE}/` },
        author,
        publisher: author,
        license: 'https://creativecommons.org/licenses/by/4.0/',
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, ...crumb })),
      },
    ],
  };
}
---

<Default />

<link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={instrumentLatin} as="font" type="font/woff2" crossorigin />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script>
  // Renderiza los diagramas Mermaid sólo en las páginas que los tienen y los
  // vuelve a dibujar al cambiar entre tema claro y oscuro.
  const blocks = [...document.querySelectorAll<HTMLElement>('pre.mermaid')];
  if (blocks.length > 0) {
    const { default: mermaid } = await import('mermaid');
    for (const block of blocks) block.dataset.source = block.textContent ?? '';
    const render = async () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      const font = "'Instrument Sans Variable', system-ui, sans-serif";
      const themeVariables = dark
        ? { background: '#0b120e', primaryColor: '#16211b', primaryTextColor: '#f3f0e6', primaryBorderColor: '#4ccd8a', lineColor: '#8f9a8f', textColor: '#f3f0e6', edgeLabelBackground: '#16211b', tertiaryColor: '#12301f', fontFamily: font }
        : { background: '#f8f6ef', primaryColor: '#e9e5d8', primaryTextColor: '#0e1a13', primaryBorderColor: '#0f5a31', lineColor: '#4f5d54', textColor: '#0e1a13', edgeLabelBackground: '#f1ede2', tertiaryColor: '#cdeedb', fontFamily: font };
      mermaid.initialize({ startOnLoad: false, theme: 'base', themeVariables, securityLevel: 'strict' });
      for (const block of blocks) {
        block.removeAttribute('data-processed');
        block.textContent = block.dataset.source ?? '';
      }
      await mermaid.run({ nodes: blocks });
    };
    await render();
    new MutationObserver(render).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
